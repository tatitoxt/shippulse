CLICKHOUSE_PASSWORD=replace-before-start

DATABASE_URL=postgres://shippulse:replace-before-start@postgres:5432/shippulse?sslmode=disable
REDIS_URL=redis:6379
NATS_URL=nats://nats:4222
JWT_SECRET=replace-before-start
GITHUB_WEBHOOK_SECRET=replace-before-start
